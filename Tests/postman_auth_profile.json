  "item": [
    {
      "name": "🔐 AUTENTICACIÓN",
      "item": [
        {
          "name": "1️⃣  Login como ADMIN",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set(\"token\", jsonData.data.access_token);",
                  "    pm.environment.set(\"user_id\", jsonData.data.user_id);",
                  "    pm.environment.set(\"username\", jsonData.data.username);",
                  "    console.log('✅ Token guardado: ' + jsonData.data.access_token.substring(0, 20) + '...');",
                  "} else {",
                  "    pm.test('Login Failed', function() {",
                  "        pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\\n  \\\"username\\\": \\\"admin\\\",\\n  \\\"password\\\": \\\"admin123\\\",\\n  \\\"ip_origin\\\": \\\"127.0.0.1\\\",\\n  \\\"user_agent\\\": \\\"Postman\\\"\\n}"
            },
            "url": {
              "raw": "{{auth_url}}/api/v1/sesiones",
              "host": ["{{auth_url}}"],
              "path": ["api", "v1", "sesiones"]
            }
          },
          "response": []
        },
        {
          "name": "2️⃣  Login como ESTUDIANTE",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set(\"token_estudiante\", jsonData.data.access_token);",
                  "    console.log('✅ Token estudiante guardado');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\\n  \\\"username\\\": \\\"estudiante\\\",\\n  \\\"password\\\": \\\"estud123\\\",\\n  \\\"ip_origin\\\": \\\"127.0.0.1\\\",\\n  \\\"user_agent\\\": \\\"Postman\\\"\\n}"
