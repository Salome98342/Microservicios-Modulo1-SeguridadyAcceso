# Database Configuration
DB_HOST=db
DB_PORT=5432
DB_NAME=db_usuarios
DB_USER=postgres
DB_PASSWORD=postgres

# Application Configuration
DEBUG_MODE=false

# Security Keys & Tokens (CHANGE THESE IN PRODUCTION!)
AES_SECRET_KEY=your_aes_secret_key_here_change_in_production
BCRYPT_ROUNDS=12
USR_APP_TOKEN=your_usr_app_token_here_change_in_production

# External Service Tokens
AUTH_APP_TOKEN=your_auth_app_token_here_change_in_production
ROL_APP_TOKEN=your_rol_app_token_here_change_in_production
NOT_APP_TOKEN=your_not_app_token_here_change_in_production
AUD_APP_TOKEN=your_aud_app_token_here_change_in_production

# External Service URLs
AUTH_SERVICE_URL=http://ms-autenticacion:8001
ROL_SERVICE_URL=http://ms-roles:8002
NOT_SERVICE_URL=http://ms-notificaciones:8003
AUD_SERVICE_URL=http://ms-auditoria:8004

# Timeouts (in seconds)
TIMEOUT_AUTH=3
TIMEOUT_ROL=3
TIMEOUT_NOT=1
TIMEOUT_AUD=0.5
